<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 内网 HTTP 直连（192.168.x.x / 局域网域名）；上 HTTPS 后可收紧 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
