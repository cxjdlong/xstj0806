<?xml version="1.0" encoding="utf-8"?>
<!-- 锁屏/通知栏：常规播放器卡片（封面 + 歌名歌手 + 一行歌词 + 进度条 + 控制键）
     歌词行的文字颜色/底色跟随 App 里选定的歌词颜色（代码里 setTextColor / setBackgroundColor）。
     进度条只能显示（RemoteViews 收不到拖动），两头给了 -10s / +10s，点进度条本身会打开 App。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#33000000"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/n_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="#33FFFFFF"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/app_name" />

            <!-- 歌手这一排：左边歌手，右侧显示歌曲源 / 播放提示 / 音频加载进度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/n_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:text="" />

                <TextView
                    android:id="@+id/n_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="140dp"
                    android:background="@drawable/nmode_bg"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:text="源" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- 一排歌词（当前句）：文字色 + 淡底色都跟随 App 里的歌词颜色 -->
    <TextView
        android:id="@+id/n_lyric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#4CD964"
        android:text="♪" />

    <!-- 进度：-10s ｜ 进度条 ｜ +10s -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/n_back10"
            style="@style/NSeek"
            android:text="-10s" />

        <ProgressBar
            android:id="@+id/n_prog"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="#2F6FFF"
            android:progressBackgroundTint="#66FFFFFF" />

        <TextView
            android:id="@+id/n_fwd10"
            style="@style/NSeek"
            android:text="+10s" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/n_cur"
            style="@style/NTime"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="0:00" />

        <TextView
            android:id="@+id/n_dur"
            style="@style/NTime"
            android:text="0:00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/n_prev"
                style="@style/NBtn"
                android:text="⏮" />

            <TextView
                android:id="@+id/n_toggle"
                style="@style/NBtn"
                android:text="⏯" />

            <TextView
                android:id="@+id/n_next"
                style="@style/NBtn"
                android:text="⏭" />
        </LinearLayout>

        <TextView
            android:id="@+id/n_mode"
            style="@style/NMode"
            android:text="循" />
    </LinearLayout>
</LinearLayout>
