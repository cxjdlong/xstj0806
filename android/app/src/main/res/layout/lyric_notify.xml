<?xml version="1.0" encoding="utf-8"?>
<!-- 锁屏/通知栏播放器卡片
     歌名 → 歌手行(左歌手 ｜ 右侧标签:歌曲源/加载进度/异常提示) → 歌词(无歌词时显示歌名·作者)
     → 当前时间 ｜ 进度条 ｜ 总时长 → 控制行(⏮ ⏯ ⏭ + 模式 + 打开)
     注：整张卡片不绑点击（防误触），只有进度条和右下角「打开」会进 App。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#33000000"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/n_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="#33FFFFFF"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/app_name" />

            <!-- 歌手这一排：左边歌手，右侧显示歌曲源 / 播放提示 / 音频加载进度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/n_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:text="" />

                <TextView
                    android:id="@+id/n_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="140dp"
                    android:background="@drawable/nmode_bg"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:text="源" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 一行歌词（当前句）：没有歌词时代码会填「歌名 · 作者」 -->
    <TextView
        android:id="@+id/n_lyric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#4CD964"
        android:text="♪" />

    <!-- 进度：当前时间 ｜ 进度条 ｜ 总时长（点进度条进 App 拖动） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/n_cur"
            style="@style/NTime"
            android:text="0:00" />

        <ProgressBar
            android:id="@+id/n_prog"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="#2F6FFF"
            android:progressBackgroundTint="#66FFFFFF" />

        <TextView
            android:id="@+id/n_dur"
            style="@style/NTime"
            android:text="--:--" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/n_prev"
                style="@style/NBtn"
                android:text="⏮" />

            <TextView
                android:id="@+id/n_toggle"
                style="@style/NBtn"
                android:text="❚❚" />

            <TextView
                android:id="@+id/n_next"
                style="@style/NBtn"
                android:text="⏭" />
        </LinearLayout>

        <TextView
            android:id="@+id/n_mode"
            style="@style/NMode"
            android:text="循" />

        <TextView
            android:id="@+id/n_open"
            style="@style/NMode"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:text="打开" />
    </LinearLayout>
</LinearLayout>
