<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色主题：窗口底色跟着网页走，别用纯黑（否则启动/切换时闪黑） -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F2F4F8</item>
        <item name="android:statusBarColor">#F2F4F8</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 锁屏歌词：当前句（大字，绿色高亮） -->
    <style name="NLrcCur">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#4CD964</item>
        <item name="android:text">" "</item>
    </style>
    <!-- 锁屏歌词：当前句附近的（小字） -->
    <style name="NLrcNear">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#99FFFFFF</item>
        <item name="android:text">" "</item>
    </style>
    <!-- 锁屏歌词：最外两行（更淡） -->
    <style name="NLrcFar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#66FFFFFF</item>
        <item name="android:text">" "</item>
    </style>

    <!-- 通知里的控制按钮：上一首 / 播放暂停 / 下一首 -->
    <style name="NBtn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">22dp</item>
        <item name="android:layout_marginRight">22dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 进度条两头的 -10s / +10s -->
    <style name="NSeek">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/nmode_bg</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 进度两端的当前时间 / 总时长 -->
    <style name="NTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">#99FFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- 播放模式按钮（顺 / 循 / 单 / 随） -->
    <style name="NMode">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:paddingLeft">9dp</item>
        <item name="android:paddingRight">9dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:background">@drawable/nmode_bg</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
